# ============================================================
# .gitignore — 通用项目版本控制排除规则 (Git 语法)
# ============================================================

# ---------- 依赖目录 ----------
node_modules

# ---------- 构建产物目录 ----------
dist/
build/
target/

# ---------- 系统隐藏文件 ----------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ---------- IDE / 编辑器配置目录 ----------
.idea/
.vscode/
*.swp
*.swo
*~

# ---------- 日志文件 ----------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- 环境变量与密钥文件 ----------
.env
.env.*
!.env.example
!.env.sample

# ---------- 缓存目录 ----------
.cache/

# ---------- 临时文件 ----------
*.tmp
*.temp
*.bak
*.backup
*.old

package-lock.json
.workbuddy
