{
  "name": "cyber-audio-visualizer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n vite,relay,movie -c cyan,magenta,green \"vite\" \"node server/mcp-relay.mjs\" \"node server/movie-search.mjs\"",
    "prebuild": "node scripts/clean-dist.cjs",
    "build": "vite build",
    "preview": "vite preview",
    "mcp-relay": "node server/mcp-relay.mjs",
    "genimg": "node server/image-proxy.mjs",
    "movie-search": "node server/movie-search.mjs",
    "dev:all": "concurrently -n vite,relay,genimg,movie -c cyan,magenta,yellow,green \"vite\" \"node server/mcp-relay.mjs\" \"node server/image-proxy.mjs\" \"node server/movie-search.mjs\"",
    "test": "node scripts/verify-engine.cjs && node --test tests/sse.test.mjs tests/toolCalls.test.mjs tests/mcp.test.mjs",
    "test:sse": "node --test tests/sse.test.mjs",
    "verify": "node scripts/verify-engine.cjs && node scripts/clscheck.mjs"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.2.5",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "concurrently": "^10.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "tavily-mcp": "^0.2.22",
    "vite": "^5.4.10"
  }
}
