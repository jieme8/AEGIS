# ============================================================
# 环境变量模板（example）
# —— 本文件可被 git 提交（.gitignore 已白名单 !.env.example）
# —— 使用前复制为 .env 并填入真实密钥：  cp .env.example .env
#
# 重要：只有 VITE_ 前缀的变量会被 Vite 暴露到前端 bundle，
#       因此这些 key 会出现在浏览器侧（dev 走代理注入/透传，prod 直连）。
# ============================================================

# ---------- 供应商 1：LongCat（支持多 key，过期前优先消耗） ----------
# 逗号分隔；可选 @YYYY-MM-DD 过期标记（UI 据此提示「将过期 / 过期」）。
# 例：VITE_LONGCAT_API_KEYS=ak_aaa,ak_bbb@2026-09-01,ak_ccc
VITE_LONGCAT_API_KEYS=ak_REPLACE_WITH_YOUR_LONGCHAT_KEY

# 可选：下拉框中显示的名字（覆盖默认 LongCat-N）
# VITE_LONGCAT_LABEL=longCat

# （向后兼容）若不想用上面的多 key，也可只填单 key；
# 一旦设置了 VITE_LONGCAT_API_KEYS，此项会被忽略。
# VITE_LONGCAT_API_KEY=ak_REPLACE_WITH_YOUR_LONGCHAT_KEY

# ---------- 供应商 2：阿里 CodePlan（千问） ----------
# 文档：https://platform.qianwenai.com/docs/developer-guides/getting-started/first-api-call
VITE_QWEN_API_KEY=sk-ws-REPLACE_WITH_YOUR_QWEN_KEY

# 可选：模型名，默认 qwen-coder-plus
VITE_QWEN_MODEL=qwen-coder-plus

# 可选：OpenAI 兼容 base URL（不含 /chat/completions），默认 dashscope
# 例：ModelScope token-plan
# VITE_QWEN_ENDPOINT=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# 可选：下拉框中显示的名字（默认 阿里TokenPlan）
# VITE_QWEN_LABEL=阿里TokenPlan

# 可选：过期日（YYYY-MM-DD 或时间戳），用于 UI 过期提醒
# VITE_QWEN_EXPIRES=2026-12-31

# ============================================================
# 生图 Provider：Agnes Image 2.1 Flash（服务端持有，不进前端）
# —— 这些变量「没有」VITE_ 前缀，Vite 不会注入到前端 bundle；
# —— 只在 server/image-proxy.mjs（Node 侧）读取，用于调用真实生图 API。
# 文档：https://agnes-ai.com/doc/agnes-image-21-flash
# 启用：把 src/config/imageConfig.js 的 provider 设为 "http"
# ============================================================
# IMAGE_API_KEY=sk-REPLACE_WITH_YOUR_AGNES_KEY
# IMAGE_BASE_URL=https://apihub.agnes-ai.com/v1/images/generations
# IMAGE_MODEL=agnes-image-2.1-flash

# ---------- Tavily MCP（AI 联网搜索，可选但推荐） ----------
# 服务端读取（node server/mcp-relay.mjs），供 tavily-mcp 子进程使用。
# 不设置时以 keyless 模式运行（仅 Search / Extract 可用）。
# 申请：https://tavily.com -> 注册登录 -> Dashboard 复制 API Key
TAVILY_API_KEY=tvly-REPLACE_WITH_YOUR_TAVILY_KEY

# ---------- 高级模式：自定义任意供应商（JSON 数组） ----------
# 一旦设置 VITE_PROVIDERS，上面的「便捷模式」自动配置全部忽略，以 JSON 为准。
# 每条字段：id, label, endpoint(完整 /chat/completions 地址), apiKey, model, expiresAt(可选)
# 例：
# VITE_PROVIDERS=[{"id":"lc","label":"LongCat","endpoint":"https://api.longcat.chat/v1/chat/completions","apiKey":"ak_xxx","model":"LongCat-2.0"},{"id":"qw","label":"CodePlan(阿里)","endpoint":"https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions","apiKey":"sk-ws-xxx","model":"qwen-coder-plus"}]
